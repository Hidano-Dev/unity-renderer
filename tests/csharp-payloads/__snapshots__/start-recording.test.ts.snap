// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`start-recording payload > starts Play Mode recording and reports progress through an atomic status file 1`] = `
"// Unity eval payload: enter Play Mode, start the in-memory Recorder, and publish
// status updates without ever writing a Scene or an Asset.
var parametersJson = "{\\"statusPath\\":\\"C:\\\\\\\\renders\\\\\\\\status.json\\",\\"operationId\\":\\"scene-01-run-1\\"}";

string JsonString(string json, string key)
{
    var match = System.Text.RegularExpressions.Regex.Match(json, "\\\\\\"" + key + "\\\\\\"\\\\s*:\\\\s*\\\\\\"((?:\\\\\\\\.|[^\\\\\\"\\\\\\\\])*)\\\\\\"");
    if (!match.Success)
        throw new System.ArgumentException("Missing required payload parameter: " + key);
    return System.Text.RegularExpressions.Regex.Unescape(match.Groups[1].Value);
}

var statusPath = JsonString(parametersJson, "statusPath");
var operationId = JsonString(parametersJson, "operationId");
var statusDirectory = System.IO.Path.GetDirectoryName(statusPath);
if (string.IsNullOrEmpty(statusDirectory))
    throw new System.ArgumentException("statusPath must include a directory");
System.IO.Directory.CreateDirectory(statusDirectory);

void WriteStatus(string state, double progress, string error)
{
    var tempPath = statusPath + ".tmp";
    var progressText = progress.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var errorJson = error == null ? "null" : "\\"" + error.Replace("\\\\", "\\\\\\\\").Replace("\\"", "\\\\\\"") + "\\"";
    var json = "{\\"operationId\\":\\"" + operationId + "\\",\\"state\\":\\"" + state + "\\",\\"progress\\":" + progressText + ",\\"error\\":" + errorJson + "}";
    System.IO.File.WriteAllText(tempPath, json, System.Text.Encoding.UTF8);
    System.IO.File.Move(tempPath, statusPath, true);
}

var controller = UnityEditor.Recorder.RecorderController.Instance;
WriteStatus("starting", 0, null);

void UpdateRecording()
{
    try
    {
        if (controller.IsRecording())
        {
            WriteStatus("recording", 0, null);
            return;
        }

        UnityEditor.EditorApplication.update -= UpdateRecording;
        WriteStatus("completed", 1, null);
    }
    catch (System.Exception exception)
    {
        UnityEditor.EditorApplication.update -= UpdateRecording;
        WriteStatus("failed", 0, exception.Message);
    }
}

void StartRecording()
{
    try
    {
        controller.PrepareRecording();
        controller.StartRecording();
        UnityEditor.EditorApplication.update += UpdateRecording;
        WriteStatus("recording", 0, null);
    }
    catch (System.Exception exception)
    {
        WriteStatus("failed", 0, exception.Message);
        throw;
    }
}

// A delay call lets the Editor finish the domain reload caused by entering Play Mode.
UnityEditor.EditorApplication.delayCall += StartRecording;
UnityEditor.EditorApplication.isPlaying = true;
"
`;
